<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent launch drawable.
    No background, logo, or branding is rendered by ScoreZone's native splash.
    The goal is to minimize the visual transition before the single WebView paints.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
</shape>
