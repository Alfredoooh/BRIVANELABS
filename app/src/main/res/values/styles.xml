<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScoreZone" parent="android:style/Theme.Material.Light.NoActionBar">
        <!-- Transparent launch surface: no native splash branding or solid flash. -->
        <item name="android:windowBackground">@drawable/splash_transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
